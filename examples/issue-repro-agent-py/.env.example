# Solari — Starter or free tier both work. console.getsolari.com -> API Keys.
SOLARI_API_KEY=slr_live_...

# LLM for the fix step — set ONE. Omit both to force --dry-run (repro + report,
# no fix). GROQ_API_KEY wins if both are set.
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...

# GitHub PAT with 'repo' scope — omit to skip the PR (the branch is still
# pushed and the compare URL is printed).
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your-handle

# Optional: override the model used for the fix step.
REPRO_AGENT_MODEL=claude-sonnet-5
